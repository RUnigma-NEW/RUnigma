+      pos = config_source1 + 1;
+
+      D_DEBUG_AT (BDISP_NODES,
+                  "BLT_S1BA BLT_S1TY BLT_S1XY         : %.8x %.8x %.8x\n",
+                  config_source1->BLT_S1BA, config_source1->BLT_S1TY,
+                  config_source1->BLT_S1XY);
