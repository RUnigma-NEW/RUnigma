+static int
+stgfxScreenDataSize (void)
+{
+  D_DEBUG_AT (STGFX_Screen, "%s (%u)\n",
+              __FUNCTION__, sizeof (STGFXScreenSharedData));
+
+  return sizeof (STGFXScreenSharedData);
+}
