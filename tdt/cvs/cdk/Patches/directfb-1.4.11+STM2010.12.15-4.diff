+
+stgfx2dir = $(MODULEDIR)/gfxdrivers
+
+libdirectfb_stgfx2_la_SOURCES =	\
+	stgfx2_features.h	\
+	stm_types.h		\
+	\
+	stm_gfxdriver.c		\
