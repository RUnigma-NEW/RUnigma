+              gettimeofday (&start, NULL);
+
+  #define bdisp_aq_WaitSpace_end_timer() \
+              gettimeofday (&end, NULL);                               \
+              timersub (&end, &start, &end);                           \
+              D_INFO ("BDisp/BLT: had to wait for space %lu.%06lus\n", \
+                      end.tv_sec, end.tv_usec);                        \
+            })
