+  u32 BLT_S1TY;
+  u32 BLT_S1XY;
+  u32 dummy;
+};
+/* source 2 config */
+struct _BltNodeGroup04 {
+  u32 BLT_S2BA;
+  u32 BLT_S2TY;
+  u32 BLT_S2XY;
+  u32 BLT_S2SZ;
