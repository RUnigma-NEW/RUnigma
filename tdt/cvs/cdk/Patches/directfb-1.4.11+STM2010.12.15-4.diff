+#define DFB_FIXED_POINT_TO_BDISP(f)  ((f) >> 6)
+
+static int
+FixedPointToInteger (int  f16,
+                     u32 * const fraction)
+{
+  int integer = DFB_FIXED_POINT_TO_INT (f16);
+
+  if (fraction)
+    *fraction = f16 - (DFB_FIXED_POINT_VAL (integer));
+
+  return integer;
+}
