+{
+  dbuf->ScatterPages_p[0].BytesUsed = 0;
+  dbuf->ScatterPages_p[0].FlagsIn   = 0;
+  dbuf->ScatterPages_p[0].FlagsOut  = 0;
+
+  return buffer_to_ptr_copy (buffer, dbuf->ScatterPages_p[0].Page_p, len);
+}
