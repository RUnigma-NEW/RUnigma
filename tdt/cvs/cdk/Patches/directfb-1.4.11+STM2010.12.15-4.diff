diff -Nur DirectFB-1.4.11.orig/gfxdrivers/stgfx2/Makefile.am DirectFB-1.4.11/gfxdrivers/stgfx2/Makefile.am
--- DirectFB-1.4.11.orig/gfxdrivers/stgfx2/Makefile.am	1969-12-31 16:00:00.000000000 -0800
+++ DirectFB-1.4.11/gfxdrivers/stgfx2/Makefile.am	2010-12-15 09:45:58.000000000 -0800
@@ -0,0 +1,68 @@
+## Makefile.am for DirectFB/gfxdrivers/stgfx2
+
+INCLUDES = \
