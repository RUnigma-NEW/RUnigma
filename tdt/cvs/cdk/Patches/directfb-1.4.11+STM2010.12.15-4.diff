+static const DFBSurfaceDrawingFlags STGFX_VALID_BLITTINGFLAGS_BDISP = (
+  DSBLIT_INDEX_TRANSLATION  |
+  DSBLIT_SRC_COLORKEY       |
+  DSBLIT_BLEND_COLORALPHA   |
+  DSBLIT_BLEND_ALPHACHANNEL |
+  DSBLIT_SRC_PREMULTIPLY    |
+  DSBLIT_XOR                |
