+static void
+_dump_node (const struct _BltNodeGroup00 * const config_general)
+{
+  const struct _BltNodeGroup01 * const config_target =
+    (struct _BltNodeGroup01 *) (config_general + 1);
+  const void *pos = config_target + 1;
