+
+static DFBResult
+buffer_to_ptr_copy (IDirectFBDataBuffer * const buffer,
+                    void                * ptr,
+                    int                  len)
+{
+  DFBResult ret;
+
+  while (len > 0)
+    {
+      unsigned int read;
+
+      ret = buffer->WaitForData (buffer, len);
+      if (ret == DFB_OK)
+        ret = buffer->GetData (buffer, len, ptr, &read);
+
+      if (ret)
+        return ret;
+
+      ptr += read;
+      len -= read;
+    }
+
+  return DFB_OK;
+}
