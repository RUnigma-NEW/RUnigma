+        printf("MMIO: %dKB @ 0x%x\n", devinfo.iosize >> 10, devinfo.iomem);
+
+        r = uc_mmap_vga_device(&devinfo, name);
+        if (r == DFB_OK) {
+            printf("IO area mmapped to 0x%x.\n", (u32) devinfo.iomap);
+        }
