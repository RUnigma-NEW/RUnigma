+      D_DEBUG_AT (BDISP_NODES,
+                  "BLT_OVMX BLT_OVMX BLT_OVMX BLT_OVMX: %.8x %.8x %.8x %.8x\n",
+                  config_ovmx->BLT_OVMX0, config_ovmx->BLT_OVMX1,
