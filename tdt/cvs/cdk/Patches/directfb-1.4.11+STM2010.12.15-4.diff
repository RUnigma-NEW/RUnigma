+static char *
+_get_matrix_string (const s32 *matrix)
+{
+  char *str = malloc (220);
+  int pos = 0, i;
+
+  for (i = 0; i < 3; ++i, ++matrix)
+    pos += sprintf (str + pos, "[%.3x.%.3x] ", (*matrix) >> 16, (*matrix) & 0xffff);
+  pos += sprintf (str + pos, "\n            ");
+  for (i = 0; i < 3; ++i, ++matrix)
+    pos += sprintf (str + pos, "[%.3x.%.3x] ", (*matrix) >> 16, (*matrix) & 0xffff);
+  pos += sprintf (str + pos, "\n            ");
+  for (i = 0; i < 3; ++i, ++matrix)
+    pos += sprintf (str + pos, "[%.3x.%.3x] ", (*matrix) >> 16, (*matrix) & 0xffff);
+  pos += sprintf (str + pos, "\n");
+
+  return str;
