+      pos = config_filters + 1;
+
+      D_DEBUG_AT (BDISP_NODES,
+                  "BLT_FCTL BLT_PMK                   : %.8x %.8x\n",
+                  config_filters->BLT_FCTL_RZC, config_filters->BLT_PMK);
