--- DirectFB-1.4.11.orig/tests/fixup_rle.c	1969-12-31 16:00:00.000000000 -0800
+++ DirectFB-1.4.11/tests/fixup_rle.c	2010-12-15 09:45:58.000000000 -0800
@@ -0,0 +1,180 @@
+/*
+ * Copyright (C) 2006 ST-Microelectronics R&D <alain.clement@st.com>
+ *
+ * This program is free software; you can redistribute it and/or modify
+ * it under the terms of the GNU General Public License version 2 as
