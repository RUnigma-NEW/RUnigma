+static DirectResult
+IDirectFBFont_IT_Release( IDirectFBFont *thiz )
+{
+     DIRECT_INTERFACE_GET_DATA(IDirectFBFont)
+
+     if (--data->ref == 0) {
+          IDirectFBFont_IT_Destruct( thiz );
+     }
+
+     return DFB_OK;
+}
