--- DirectFB-1.4.11.orig/wm/unique/FLOW	1969-12-31 16:00:00.000000000 -0800
+++ DirectFB-1.4.11/wm/unique/FLOW	2010-12-15 09:45:58.000000000 -0800
@@ -0,0 +1,15 @@
+
+
+Input event handling
+---------------------
+
+                                   UniqueCursor
+                                        |
+                                        |
+CoreInputDevice  )---  UniquePointer  )-')-.
+                                           |
+                                   UniqueInputSwitch  -->  UniqueInputChannel  )---  UniqueWindow  -->  CoreWindow
+                                           |
+CoreInputDevice  )-.-  UniqueKeyboard  )---'
+                   |
+CoreInputDevice  )-'
